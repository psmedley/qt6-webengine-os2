import("//build/toolchain/concurrent_links.gni")
import("//build/toolchain/goma.gni")
import("//build/toolchain/rbe.gni")

declare_args() {
  # Pool for non goma tasks.
  action_pool_depth = -1

  # Max number of concurrent Node.js actions. On OS/2 running several
  # node.exe processes at once can hang the system, so serialize them.
  node_pool_depth = 1
}

if (current_toolchain == default_toolchain) {
  if (action_pool_depth == -1 || (use_goma || use_remoteexec)) {
    action_pool_depth = exec_script("get_cpu_count.py", [], "value")
  }

  pool("link_pool") {
    depth = concurrent_links
  }

  pool("action_pool") {
    depth = action_pool_depth
  }

  pool("node_pool") {
    depth = node_pool_depth
  }

  pool("remote_action_pool") {
    depth = 1000
  }
}
