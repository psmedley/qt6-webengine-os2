import("//build/config/sanitizers/sanitizers.gni")
import("//build/toolchain/toolchain.gni")

assert(is_os2)

# This is included by reference in the //build/config/compiler config that
# is applied to all targets. It is here to separate out the logic that is
# OS/2-only.
config("compiler") {
  cflags = [
    "-Zomf",
    "-mno-avx",
    "-mstackrealign",
    "-fno-common",

    # Lower cc1plus peak memory. GCC sizes its garbage collector thresholds
    # from the amount of physical RAM, which lets the heap grow far before
    # collecting; large (jumbo) Blink and V8 translation units can then
    # exceed the ~3 GB per-process address space limit on OS/2 and fail with
    # "out of memory allocating ...". Collecting more often trades some
    # compile time for a much lower peak.
    "--param=ggc-min-expand=20",
    "--param=ggc-min-heapsize=131072",
  ]

  ldflags = [
    "-Zomf",
    "-Zmap",
    "-Zhigh-mem",
    "-lcx",
    # Newer gettext is not part of LIBC (yet).
    "-lintl",
    # pthread is also not part of LIBC ATM.
    "-lpthread",
  ]
}

# Settings for EXEs.
config("os2_executable_flags") {
  ldflags = [ "-Zstack", "0x2000" ]

  # TODO: Use ldflags += [ "-Zlinker", "/PM:PM", "-Zno-fork" ] for executables
  # that need to be PM apps. For now build all executables in VIO mode (default)
  # so that they will have a console attached (see also ../win/console_app.gni).
}

# Settings for DLLs.
config("os2_dynamic_flags") {
  ldflags = [ "-Zdll" ]
}
